# Copie para .env e preencha.

# Usuário e senha do primeiro acesso (só usados enquanto não existe usuário).
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=troque-esta-senha

# Endereço público do painel, com https. Os clientes ativam e revalidam aqui,
# e os instaladores de marca saem configurados com ele.
PANEL_PUBLIC_URL=https://licencas.example.com
# Usado pelo perfil "https" do docker-compose (Caddy).
PANEL_DOMAIN=licencas.example.com
# Quantos proxies reversos há na frente do painel (1 com o Caddy acima).
PANEL_TRUSTED_PROXIES=1

# Validade padrão dos seriais, em dias.
PANEL_VALIDITY_DAYS=365
PANEL_TZ=America/Sao_Paulo

# Builds de marca pelo GitHub Actions. Token fine-grained com acesso ao
# repositório e permissão "Actions: Read and write".
GITHUB_REPO=RafaelPiassi/rustdesk
GITHUB_TOKEN=
GITHUB_REF=master
GITHUB_WORKFLOW=brand-build.yml

# Opcionais: se vazios, são gerados e guardados no volume /data.
# PANEL_SECRET_KEY=
# PANEL_SIGNING_KEY=
